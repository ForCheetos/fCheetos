aobscanregion(_ffly,base,base*2,F3 44 0F 58 7F 14) // should be unique
alloc(newmem,$4096,_ffly)
label(code)
label(return)
label(InstantEND)
label(YawRadian PitchRadian DeltaX DeltaY DeltaZ pressed)
label(ModME Speed)
newmem:

pushfq
push rax
push rbx
push rcx
push rdx
push r8
push r9
push r10
push r11
push r12
push r13
push r14
push r15
mov r15,rsp
and rsp,FFFFFFFFFFFFFFF0
sub rsp,20

mov rcx,0x57
call GetAsyncKeyState
mov qword ptr [pressed],rax

mov rsp,r15
pop r15
pop r14
pop r13
pop r12
pop r11
pop r10
pop r9
pop r8
pop rdx
pop rcx
pop rbx
pop rax
popfq

fld dword ptr [ModME]
fstp dword ptr [Speed]

cmp qword ptr [pressed],0
jbe code

cmp [base+4983D90],0
je return


  push rax
  mov rax,base+4C2C588
  test rax,rax
  jz InstantEND
  mov rax,[rax]
  test rax,rax
  jz InstantEND

  mov rax,[rax+38]
  test rax,rax
  jz InstantEND

  mov rax,[rax+10]
  test rax,rax
  jz InstantEND

  mov rax,[rax+30]
  test rax,rax
  jz InstantEND

  mov rax,[rax+f0]
  test rax,rax
  jz InstantEND

  mov rax,[rax+18]
  test rax,rax
  jz InstantEND

  mov rax,[rax+4f0]
  test rax,rax
  jz InstantEND

  mov rax,[rax+10]
  test rax,rax
  jz InstantEND

  mov rax,[rax+70]
  test rax,rax
  jz InstantEND

  push rbx
  mov rbx,SSCamera
  test rbx,rbx
  jz InstantEND

  mov rbx,[rbx]
  test rbx,rbx
  jz InstantEND

  fld qword ptr [rbx]      // Load Yaw
  fstp dword ptr [YawRadian]

  fld qword ptr [rbx+8]  // Load Pitch
  fstp dword ptr [PitchRadian]

//;X
  fld dword ptr [YawRadian]
  fcos
  fmul dword ptr [Speed]
  fstp dword ptr [DeltaX]

//;Y
  fld dword ptr [PitchRadian]
  fsin
  fmul dword ptr [Speed]
  fstp dword ptr [DeltaY]

//;Z
  fld dword ptr [YawRadian]
  fsin
  fmul dword ptr [Speed]
  fstp dword ptr [DeltaZ]

//;X
  fld dword ptr [rax+A0]
  fsub dword ptr [DeltaX]
  fstp dword ptr [rax+A0]
//;Y
  fld dword ptr [rax+A4]
  fsub dword ptr [DeltaY]
  fstp dword ptr [rax+A4]
//;Z
  fld dword ptr [rax+A8]
  fsub dword ptr [DeltaZ]
  fstp dword ptr [rax+A8]

  InstantEND:
  pop rbx
  pop rax

code:
  addss xmm15,[rdi+14]
  jmp return

  pressed:
  dq 0

ModME:
dd (float)0.1

Speed:
dd (float)1

YawRadian:
dq 00

PitchRadian:
dq 00

DeltaX:
dq 00

DeltaZ:
dq 00

DeltaY:
dq 00


_ffly:
  jmp newmem
  nop
return:
registersymbol(_ffly pressed ModME)

[DISABLE]

_ffly:
  db F3 44 0F 58 7F 14

unregistersymbol(_ffly)
dealloc(newmem)

