}
[ENABLE]
{$STRICT}
aobscanregion(fCamera,base,base * 2,66 0F 11 4E 30 F2 0F 11 46 40 0F) // should be unique
alloc(newmem,$1000,fCamera)
label(code)
label(return)
label(debugCam)
label(Straf Speed YawRadian PitchRadian DeltaX DeltaY DeltaZ PiOverTwo)
label(SlowDown SpeedUp BackUpS1 LerpCam CamSS)



//; Disabling PlayerMovement
base+1b2897b:
db 90 90 90 90 90
base+1b28980:
db 90 90 90 90 90
base+1b28985:
db 90 90 90 90 90

//; Disabling Official Game Camera Render
base+db0dd46:
db 90 90 90 90 90 90
base+db0dd51:
db 90 90 90 90 90 90 90


newmem:
push rdx
lea rdx,[rsi+30]
mov [debugCam],rdx
pop rdx

  cmp [base+4983D90],0 //; null
  je return

  fld qword ptr [rsi+30-638]
  fstp qword ptr [YawRadian]

  fld qword ptr [rsi+30-630]
  fstp qword ptr [PitchRadian]

  push rcx
  mov rcx, 57  //; VK_W
  call GetAsyncKeyState
  test eax, eax
  pop rcx
  jz @f

//;X
  fld qword ptr [YawRadian]
  fcos
  fmul qword ptr [Speed]
  fstp qword ptr [DeltaX]

//;Y
  fld qword ptr [PitchRadian]
  fsin
  fmul qword ptr [Speed]
  fstp qword ptr [DeltaY]

//;Z
  fld qword ptr [YawRadian]
  fsin
  fmul qword ptr [Speed]
  fstp qword ptr [DeltaZ]

//;X
  fld qword ptr [rsi+30]
  fsub qword ptr [DeltaX]
  fstp qword ptr [rsi+30]
//;Y
  fld qword ptr [rsi+38]
  fsub qword ptr [DeltaY]
  fstp qword ptr [rsi+38]
//;Z
  fld qword ptr [rsi+40]
  fsub qword ptr [DeltaZ]
  fstp qword ptr [rsi+40]


  @@:
  push rcx
  mov rcx, 53  //; VK_S
  call GetAsyncKeyState //win32u.NtUser
  test eax, eax
  pop rcx
  jz @f

//;X
  fld qword ptr [YawRadian]
  fcos
  fmul qword ptr [Speed]
  fstp qword ptr [DeltaX]

//;Y
  fld qword ptr [PitchRadian]
  fsin
  fmul qword ptr [Speed]
  fstp qword ptr [DeltaY]

//;Z
  fld qword ptr [YawRadian]
  fsin
  fmul qword ptr [Speed]
  fstp qword ptr [DeltaZ]

//;X
  fld qword ptr [rsi+30]
  fadd qword ptr [DeltaX]
  fstp qword ptr [rsi+30]
//;Y
  fld qword ptr [rsi+38]
  fadd qword ptr [DeltaY]
  fstp qword ptr [rsi+38]
//;Z
  fld qword ptr [rsi+40]
  fadd qword ptr [DeltaZ]
  fstp qword ptr [rsi+40]

  @@:
  push rcx
  mov rcx, 0x41  //; VK_A
  call GetAsyncKeyState
  test eax, eax
  pop rcx
  jz @f

//;X
  fld qword ptr [YawRadian]
  fadd qword ptr [PiOverTwo]
  fcos
  fmul qword ptr [Speed]
  fstp qword ptr [DeltaX]


//;Z
  fld qword ptr [YawRadian]
  fadd qword ptr [PiOverTwo]
  fsin
  fmul qword ptr [Speed]
  fstp qword ptr [DeltaZ]

//;X
  fld qword ptr [rsi+30]
  fsub qword ptr [DeltaX]
  fstp qword ptr [rsi+30]


//;Z
  fld qword ptr [rsi+40]
  fsub qword ptr [DeltaZ]
  fstp qword ptr [rsi+40]

  @@:
  push rcx
  mov rcx, 0x44  //; VK_D
  call GetAsyncKeyState
  test eax, eax
  pop rcx
  jz @f

//;X
  fld qword ptr [YawRadian]
  fsub qword ptr [PiOverTwo]
  fcos
  fmul qword ptr [Speed]
  fstp qword ptr [DeltaX]

//;Z
  fld qword ptr [YawRadian]
  fsub qword ptr [PiOverTwo]
  fsin
  fmul qword ptr [Speed]
  fstp qword ptr [DeltaZ]

//;X
  fld qword ptr [rsi+30]
  fsub qword ptr [DeltaX]
  fstp qword ptr [rsi+30]

//;Z
  fld qword ptr [rsi+40]
  fsub qword ptr [DeltaZ]
  fstp qword ptr [rsi+40]

@@:
 push rcx
 mov rcx,0x11
 call GetAsyncKeyState
 test eax,eax
 pop rcx
 jnz SlowDown

@@:
 push rcx
 mov rcx,0x10
 call GetAsyncKeyState
 test eax,eax
 pop rcx
 jnz SpeedUp

fld qword ptr [BackUpS1]
fstp qword ptr [Speed]

code:
  jmp return

  SpeedUp:
  fld qword ptr [BackUpS1+8]
  fstp qword ptr [Speed]
  jmp code

  SlowDown:
  fld qword ptr [BackUpS1+10]
  fstp qword ptr [Speed]
  jmp code

  LerpCam:
  dq (double)1

  Speed:
  dq (double)1

  BackUpS1:
  dq (double)1
  dq (double)10
  dq (double)0.3

  CamSS:
  dq 00
  dq 00
  dq 00

YawRadian:
  dq 00

PitchRadian:
  dq 00

DeltaX:
  dq 00

DeltaZ:
  dq 00

DeltaY:
  dq 00

Straf:
  dq (double)4
  dq (double)0.50

  PiOverTwo:
  dq (double)1.5708

  debugCam:
  dq 00

fCamera:
  jmp newmem
  nop 5
return:
registersymbol(fCamera YawRadian PitchRadian debugCam)
[DISABLE]

fCamera:
  db 66 0F 11 4E 30 F2 0F 11 46 40


